# .env 작성 안내용 템플릿입니다. 실제 비밀값은 .env에만 입력하세요.
# 새 환경에서는 이 파일을 .env로 복사한 뒤 값을 입력합니다.
# 실제 스왑 준비 전에는 true를 유지합니다. approve를 포함한 서명·전송 금지.
DRY_RUN=true

# OKX Onchain OS 개발자 API 인증정보 (거래소 매매용 API 키와 구분)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 업비트: 입금 조회·주소 생성에 필요한 권한만 부여하고 허용 IP를 등록합니다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 빗썸: 입금 조회·주소 생성에 필요한 권한만 부여하고 허용 IP를 등록합니다.
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=

# CoinGecko API 키. 유료 사용 여부는 추후 검토합니다.
COINGECKO_API_KEY=

# EVM 전용 지갑의 공개 주소. 조회용으로 먼저 입력할 수 있습니다.
WALLET_ADDRESS=
# 실제 거래를 준비하기 전에는 개인키를 비워 두세요.
WALLET_PRIVATE_KEY=

# 체인별 RPC URL: RPC_URL_<chainIndex> 형식으로 필요한 체인을 추가합니다.
# 아래는 입력 형식 예시이며 지원 체인을 이 목록으로 제한하지 않습니다.
# Ethereum
RPC_URL_1=
# BNB Smart Chain
RPC_URL_56=
# Polygon
RPC_URL_137=
# Arbitrum One
RPC_URL_42161=
# Base
RPC_URL_8453=
